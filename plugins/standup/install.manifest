# What ../../install.sh copies when someone installs this plugin without the plugin system.
# Verbs are documented in ../adversarial-review/install.manifest.

name   Standup
about  A very short list of what you worked on since yesterday morning: commits, PRs, Jira, aj-log.md.

file   skills/standup/SKILL.md  skills/standup/SKILL.md    /standup
file   scripts/standup.sh       skills/standup/standup.sh  gathers commits, PRs and aj-log.md

# Outside the plugin system there is no ${CLAUDE_PLUGIN_ROOT} and no /plugin:skill namespace.
rewrite  ${CLAUDE_PLUGIN_ROOT}/scripts/standup.sh  @ROOT@/skills/standup/standup.sh
rewrite  /standup:standup                          /standup

tip  /standup                  since yesterday morning, your commits
tip  /standup since friday     a longer window
tip  /standup everyone         every author, not just you
