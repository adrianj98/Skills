# What ../../install.sh copies when someone installs this plugin without the plugin system.
# Verbs are documented in ../adversarial-review/install.manifest.

name   Standup
about  A very short list of what you worked on since your last working day: commits, PRs, Jira, aj-log.md.

file   skills/standup/SKILL.md    skills/standup/SKILL.md    /standup
file   skills/standup/standup.sh  skills/standup/standup.sh  gathers commits, PRs and aj-log.md

# The script sits beside SKILL.md and is found through ${CLAUDE_SKILL_DIR}, so its path
# needs no rewrite. Outside the plugin system there is no /plugin:skill namespace.
rewrite  /standup:standup                          /standup

tip  /standup                  since your last working day, your commits
tip  /standup since friday     a longer window
tip  /standup everyone         every author, not just you
