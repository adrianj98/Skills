# What ../../install.sh copies when someone installs this plugin without the plugin system.
# Verbs are documented in ../adversarial-review/install.manifest.

name   Why Slow
about  Why this computer is slow: a read-only snapshot script, then a diagnosis that names the culprit and the fix.

file   skills/whyslow/SKILL.md     skills/whyslow/SKILL.md     /whyslow
file   skills/whyslow/snapshot.sh  skills/whyslow/snapshot.sh  read-only snapshot of CPU, memory, disk, thermal and processes

# The script sits beside SKILL.md and is found through ${CLAUDE_SKILL_DIR}, so its path
# needs no rewrite. Outside the plugin system there is no /plugin:skill namespace.
rewrite  /whyslow:whyslow                           /whyslow

tip  /whyslow                  diagnose from the snapshot alone
tip  /whyslow typing lags      weight it toward what feels slow
